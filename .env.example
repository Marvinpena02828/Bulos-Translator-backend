# Bulos Translator Backend - Environment Configuration

# Application Settings
APP_NAME=Bulos Translator API
APP_VERSION=1.0.0
DEBUG=False  # Set to True for development, False for production

# Server Settings
HOST=0.0.0.0  # Bind to all network interfaces
PORT=8000     # Default port for the API
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=bulos_translator
MONGODB_MAX_POOL_SIZE=50  # Maximum number of connections in the pool
MONGODB_MIN_POOL_SIZE=10  # Minimum number of connections in the pool


# Admin API Key (for dictionary management)
ADMIN_API_KEY=


# Mozilla DeepSpeech Settings
# Download models from: https://github.com/mozilla/DeepSpeech/releases
# Required files: .pbmm (model) and .scorer (language scorer)
DEEPSPEECH_MODEL_PATH=./models/deepspeech-0.9.3-models.pbmm
DEEPSPEECH_SCORER_PATH=./models/deepspeech-0.9.3-models.scorer


# Translation Model Settings
# Directory containing LSTM translation models for language pairs
# Expected structure: ./models/translation/{source_lang}_{target_lang}/
TRANSLATION_MODELS_DIR=./models/translation


# File Upload Limits
MAX_AUDIO_FILE_SIZE=10485760        # 10 MB in bytes
MAX_AUDIO_DURATION_SECONDS=60       # Maximum audio length in seconds


# Logging Configuration
LOG_LEVEL=INFO                      # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE_PATH=./logs/app.log       # Path to main log file
LOG_MAX_BYTES=10485760              # Max log file size before rotation (10 MB)
LOG_BACKUP_COUNT=5                  # Number of backup log files to keep


# Performance & Timeout Settings
MAX_CONCURRENT_REQUESTS=100            # Maximum concurrent API requests
TRANSLATION_TIMEOUT_SECONDS=3          # Timeout for translation operations
SPEECH_PROCESSING_TIMEOUT_SECONDS=10   # Timeout for speech transcription
EVALUATION_TIMEOUT_SECONDS=15          # Timeout for pronunciation evaluation


# CORS (Cross-Origin Resource Sharing) Settings
# For development, use ["*"] to allow all origins
# For production, specify exact origins: ["https://example.com", "https://app.example.com"]
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE"]
CORS_ALLOW_HEADERS=["*"]


# Supported Languages
# Language codes: bul (Bulos), en (English), tl (Tagalog/Filipino)
SUPPORTED_LANGUAGES=["bul", "en", "tl"]



